    "aws-cdk": "2.1147.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
